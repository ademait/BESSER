def work_body(session: Session):
    task = session.event.message
{% if a2a.merge_sends %}
    # 35b-5 entry un-flatten + O1 HITL — drive the authored governed-merge pipeline: thread the
    # human's task through each merge owner in turn (PUSH-tagged), each merged result feeding the
    # next. Replaces the single deduped fan-out so MULTIPLE governed merges each run, in order.
    # If a stage's owner pauses for human approval (requires_human → gov_pending), present the
    # slate, stash the remaining pipeline, and finalize on the human's NEXT message (O1).
    _resume = session.get("pipeline_pending")
    if _resume:
        # The human's message IS the ballot for the paused governed merge. Add it, tally, and
        # the finalized winner becomes this stage's result; then resume the remaining stages.
        session.delete("pipeline_pending")
        _pend = _resume["pending"]
        _ids = [c["id"] for c in _pend["candidates"]]
        _hb = {"voter": "human", "source": "human", "weight": 1.0, "raw": task,
               "vote": parse_ballot(task, _ids) or parse_ballot("BALLOT: " + task.strip(), _ids)}
        _decision = tally(_pend["policy_type"], _pend["ratio"], _pend["candidates"],
                          _pend["ballots"] + [_hb])
        logging.info("[governance] %s", json.dumps(_decision))
        _win = _pend["cand_text"].get(_decision["outcome"]) or next(iter(_pend["cand_text"].values()), "")
        _result = _win + _fm_footer(_decision)
        _stages = list(_resume["remaining"])
    else:
        _result, _stages = task, list(_MERGE_PIPELINE)
    while _stages:
        _service, _flow = _stages.pop(0)
        _result, _pending = _merge_send(_result, _service, _flow)
        if _pending:
            # Owner paused for human approval — present the slate, stash the rest, await ballot.
            session.set("pipeline_pending", {"pending": _pending, "remaining": _stages})
            session.reply(_result + "\n\nReply with the ID you choose (e.g. C2).")
            return
    session.reply(_result)
    return
{% endif %}
{% if a2a.peers %}
{% if a2a.governance and a2a.governance.is_voting and not a2a.states %}
    # ── item 37: governed candidate-selection vote ────────────────────────────────
    # Phase 2: a human ballot is pending → this message IS the human's chosen candidate.
    _pending = session.get("gov_pending")
    if GOVERNANCE_REQUIRES_HUMAN and _pending:
        session.delete("gov_pending")
        _ids = [c["id"] for c in _pending["candidates"]]
        _hb = {"voter": "human", "source": "human",
               "vote": parse_ballot(task, _ids) or parse_ballot("BALLOT: " + task.strip(), _ids),
               "weight": 1.0, "raw": task}
        _ballots = _pending["ballots"] + [_hb]
        _decision = tally(GOVERNANCE_POLICY_TYPE, GOVERNANCE_RATIO, _pending["candidates"], _ballots)
        logging.info("[governance] %s", json.dumps(_decision))
        # Present the winning candidate VERBATIM — it is already a complete answer from a real
        # producer; the deterministic footer is the single source of truth for the tally.
        _win = _pending["cand_text"].get(_decision["outcome"], "")
        session.reply(_win + _gov_footer(_decision))
        return

    # Round 1 — collect one candidate output from each PRODUCER (the BPMN branches that
    # flow into the gateway). The owner contributes a candidate only if it is itself a
    # producer; a pure judge/merge owner produces none ("the task says so").
    parts = _run_fanout(task, only=set(GOVERNANCE_PRODUCERS))   # [(service_id, label, text)]
    candidates, cand_text = [], {}
    for _i, (_svc, _lbl, _txt) in enumerate(parts, start=1):
        cid = f"C{_i}"; candidates.append({"id": cid, "producer": _svc}); cand_text[cid] = _txt
    if GOVERNANCE_OWNER_PRODUCES:
        own = reply_llm.predict(message=task, session=session,
                                system_message=SYSTEM_PROMPT, parameters=MERGE_PARAMS)
        _own_id = f"C{len(candidates) + 1}"
        candidates.append({"id": _own_id, "producer": GOVERNANCE_SELF or "self"}); cand_text[_own_id] = own
    if not candidates:
        # Every producer branch failed at runtime (peer down / call raised) — there is nothing
        # to vote on. Degrade gracefully instead of tallying an empty slate and presenting "".
        session.reply("No candidate outputs were produced for the governed merge, so there is "
                      "nothing to vote on. Please retry.")
        return
    _ids = [c["id"] for c in candidates]
    cand_block = "\n\n".join(f"[{c['id']}] (from {c['producer']})\n{cand_text[c['id']]}" for c in candidates)

    # Round 2 — each VOTER (the policy participant list) votes over the FULL candidate set;
    # the owner votes in-process only if it is itself a participant.
    _voters = set(GOVERNANCE_WEIGHTS) - {GOVERNANCE_SELF}
    ballots = []
    for _svc, _lbl, _reply in _run_fanout(cand_block + BALLOT_INSTRUCTION, only=_voters):
        ballots.append({"voter": _svc, "source": "agent", "vote": parse_ballot(_reply, _ids),
                        "weight": _gov_weight(_svc), "raw": _reply})
    if GOVERNANCE_OWNER_VOTES:
        _own_vote = _gov_owner_ballot(session, cand_block, _ids)
        ballots.append({"voter": GOVERNANCE_SELF or "self", "source": "owner",
                        "vote": parse_ballot(_own_vote, _ids), "weight": _gov_weight(GOVERNANCE_SELF or ""),
                        "raw": _own_vote})
    for _name in GOVERNANCE_UNRESOLVED:             # participants with no running service
        ballots.append({"voter": _name, "source": "agent", "vote": None, "weight": 1.0, "raw": ""})

    if GOVERNANCE_REQUIRES_HUMAN:
        # Defer the final tally to the human: stash candidates + the agent/owner ballots,
        # present the slate, and let phase 2 (above) add the human ballot and tally.
        session.set("gov_pending", {"candidates": candidates, "cand_text": cand_text, "ballots": ballots})
        session.reply("A governance policy requires human approval before merging.\n\n"
                      + GOVERNANCE_SUMMARY + "\n\nCandidate outputs:\n" + cand_block
                      + "\n\nReply with the ID you choose (e.g. C2).")
        return

    _decision = tally(GOVERNANCE_POLICY_TYPE, GOVERNANCE_RATIO, candidates, ballots)
    logging.info("[governance] %s", json.dumps(_decision))
    # Present the winning candidate VERBATIM — it is already a complete answer from a real
    # producer; re-running it through the LLM only risks mutating it and re-narrating a fake
    # process. The deterministic footer is the single source of truth for the tally.
    _win = cand_text.get(_decision["outcome"]) or next(iter(cand_text.values()), "")
    final = _win + _gov_footer(_decision)
{% else %}
{% if a2a.governance and not a2a.states %}
    # Human-in-the-loop phase 2 (item 35, non-voting policies): this message IS the
    # human's decision. Apply it to the stashed candidates WITHOUT re-running the swarm.
    _pending = session.get("gov_pending")
    if GOVERNANCE_REQUIRES_HUMAN and _pending:
        session.delete("gov_pending")
        sys_msg = SYSTEM_PROMPT + "\n\n" + GOVERNANCE_INSTRUCTION
        final = reply_llm.predict(
            message=("Original task: " + _pending["task"]
                     + "\n\nCollaborators' replies:\n" + _pending["ctx"]
                     + "\n\nThe human's decision: " + task
                     + "\n\nProduce the final merged answer that honours the human's decision."),
            session=session, system_message=sys_msg, parameters=MERGE_PARAMS)
        session.reply(final)
        return
{% endif %}
    parts = _run_fanout(task)
    ctx = "\n\n".join(f"[{name} · {label}]\n{txt}" for name, label, txt in parts)
{% if a2a.governance and not a2a.states %}
    if GOVERNANCE_REQUIRES_HUMAN:
        session.set("gov_pending", {"task": task, "ctx": ctx})
        session.reply("A governance policy requires human approval before merging.\n\n"
                      + GOVERNANCE_SUMMARY
                      + "\n\nCandidate replies:\n" + ctx
                      + "\n\nReply with your decision (choose one, combine, or edit).")
        return
    sys_msg = SYSTEM_PROMPT + "\n\n" + GOVERNANCE_INSTRUCTION
    final = reply_llm.predict(message=f"Task: {task}\n\nCollaborators' replies:\n{ctx}",
                              session=session, system_message=sys_msg, parameters=MERGE_PARAMS)
{% else %}
    final = reply_llm.predict(message=f"Task: {task}\n\nTeam results:\n{ctx}",
                              session=session, system_message=SYSTEM_PROMPT)
{% endif %}
{% endif %}
{% else %}
    final = reply_llm.predict(message=task, session=session, system_message=SYSTEM_PROMPT)
{% endif %}
    session.reply(final)
work.set_body(work_body)
work.when_no_intent_matched().go_to(work)
{% endif %}

