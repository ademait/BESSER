SYSTEM_PROMPT = {{ a2a.prompt | tojson }}
{% if a2a.governance %}
# item 35 — governance policy authored on the BPMN merging gateway, parsed at generation
# time into a runtime instruction (guide 10 §2, Option B+). The LLM enforces it; if a human
# participant is in the policy, defer the decision to the human via the UI instead.
GOVERNANCE_INSTRUCTION = {{ a2a.governance.instruction | tojson }}
# Human-readable policy facts (no LLM directive) — shown to the person at the approval step.
GOVERNANCE_SUMMARY = {{ a2a.governance.summary | tojson }}
# tojson would emit JS-style `true`/`false`; render a Python bool literal instead.
GOVERNANCE_REQUIRES_HUMAN = {{ 'True' if a2a.governance.requires_human else 'False' }}
# Merge-path completions (candidate / ballot / synthesis) are decision-bearing, not chat:
# run them at temperature 0 so the same inputs yield the same answer and a ballot reliably
# carries its `BALLOT:` line. Default-temperature peer replies are unaffected (each peer
# runs its own LLM); this only pins the owner's own merge-path predicts.
MERGE_PARAMS = {"temperature": 0}
{% endif %}
{% if a2a.governance and a2a.governance.is_voting %}
# item 37 — exact governance vote tally. The owner runs a two-round candidate-selection
# vote, counted deterministically in-container by the baked engine below (guide 12 §2).
# PRODUCERS and VOTERS are decoupled: round 1 collects one candidate from each producer
# (the BPMN branches into the gateway); round 2 collects one ballot from each voter (the
# policy participant list). The owner produces / votes in-process only if it is itself a
# producer / participant. The baked engine module carries its own `import re`.
GOVERNANCE_POLICY_TYPE = {{ a2a.governance.policy_type | tojson }}
GOVERNANCE_RATIO = {{ a2a.governance.ratio if a2a.governance.ratio is not none else 'None' }}
GOVERNANCE_WEIGHTS = {{ a2a.governance.weights | tojson }}       # {voter_service: confidence}
GOVERNANCE_PRODUCERS = {{ a2a.governance.producer_services | tojson }} # candidate producers (round 1)
GOVERNANCE_OWNER_PRODUCES = {{ 'True' if a2a.governance.owner_produces else 'False' }}
GOVERNANCE_OWNER_VOTES = {{ 'True' if a2a.governance.owner_votes else 'False' }}
GOVERNANCE_UNRESOLVED = {{ a2a.governance.unresolved | tojson }} # participants with no service
GOVERNANCE_SELF = {{ a2a.governance.self_service | tojson }}
BALLOT_INSTRUCTION = ("\n\nYou are voting under a governance policy. Review ALL the candidate "
                      "outputs above and choose the single best one. End your reply with exactly "
                      "one line `BALLOT: C<k>` (e.g. `BALLOT: C2`), then one sentence of rationale.")

{{ a2a.governance.engine_src }}

def _gov_weight(voter):
    base = voter.split('#', 1)[0]   # strip a replica suffix (agent_x#2 -> agent_x)
    w = GOVERNANCE_WEIGHTS.get(base)
    return float(w) if isinstance(w, (int, float)) else 1.0

def _gov_footer(decision):
    _t = ", ".join(f"{k}={v:g}" for k, v in decision["scores"].items())
    _line = ("\n\n— governance —\n"
             f"policy {decision['policy']} (ratio {decision['ratio']}); "
             f"winner {decision['outcome']} (share {decision['share']:g}, "
             f"{'met' if decision['met_ratio'] else 'BELOW'} ratio); "
             f"votes [{_t}]; abstain {decision['abstain']}")
    return _line

def _gov_owner_ballot(session, cand_block, ids):
    # The owner's own ballot must carry a parseable `BALLOT: C<k>` line. At temperature 0
    # one completion is usually enough, but validate the structured output actually
    # appeared and re-prompt once (more emphatic) before recording the owner as an abstain
    # — so a single stray completion can't silently drop the owner's vote.
    _msg = cand_block + BALLOT_INSTRUCTION
    _txt = ""
    for _attempt in range(2):
        _txt = reply_llm.predict(message=_msg, session=session,
                                 system_message=SYSTEM_PROMPT, parameters=MERGE_PARAMS)
        if parse_ballot(_txt, ids) is not None:
            return _txt
        _msg = (cand_block + BALLOT_INSTRUCTION + "\n\nYour previous reply did NOT end with the "
                "required `BALLOT: C<k>` line. Reply again, ending with exactly that line.")
    logging.warning("[governance] owner ballot missing a valid BALLOT line after retry; "
                    "recording the owner as an abstain")
    return _txt
{% endif %}

{% if a2a.peers %}
# ── A2A client: fan out to every replica of each downstream peer (plan §5, Q4) ──
def _peer_replica_urls(service, port=8000):
    # Docker embedded DNS returns one A-record per running replica (R1: plain-compose
    # multi-record vs Swarm `tasks.<svc>` — pin the runtime in the runbook). Falls
    # back to the service VIP (one replica) if only one address resolves.
    try:
        ips = sorted({ai[4][0] for ai in socket.getaddrinfo(service, port, proto=socket.IPPROTO_TCP)})
    except OSError:
        ips = []
    return [f"http://{ip}:{port}" for ip in ips] or [f"http://{service}:{port}"]

def _a2a_call(base_url, agent_id, message):
    body = json.dumps({"jsonrpc": "2.0", "agent_id": agent_id, "method": "handle",
                       "params": {"message": message}, "id": 1}).encode()
    req = urllib.request.Request(f"{base_url}/a2a", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        data = json.loads(r.read())
    return (data.get("result") or {}).get("reply", "")

# ── per-kind framing (item 10, D4): how the requester frames the task for each peer
# kind, and the label its reply folds under. Transport is unchanged (_a2a_call); kind
# shapes only the message wording and the reply label. "plain" = no kind= (pass-through).
_KIND_FRAME = {
    "delegates":    ("Delegated subtask — complete it and return the result:\n{task}", "result"),
    "supervises":   ("Review the following work. Return approval or concrete corrections:\n{task}", "review"),
    "revises":      ("Revise the following so it is correct and complete; return the revised version:\n{task}", "revision"),
    "collaborates": ("Collaborator input — react and contribute:\n{task}", "input"),
    "plain":        ("{task}", "reply"),         # plain channel (no kind=) — pass through
}

async def _fanout(task, only=None):
    # Fire all peer replicas concurrently; exceptions are logged and filtered out. When
    # `only` is a set of service names, restrict the fan-out to those peers (the governed
    # vote uses it to address producers in round 1 and voters in round 2 separately).
    coros, meta = [], []
{% for peer in a2a.peers %}
    if only is None or "{{ peer.service }}" in only:
        _frame, _label = _KIND_FRAME[{{ (peer.kind or "plain") | tojson }}]
        _msg = _frame.format(task=task)
        _urls = _peer_replica_urls("{{ peer.service }}")
        for _i, url in enumerate(_urls):
            coros.append(asyncio.to_thread(_a2a_call, url, "{{ peer.service }}", _msg))
            # When a service runs >1 replica (BPMN lane multiplicity), suffix the instance
            # index so the merge point — and any governance vote — can tell the copies
            # apart (guide 10 G1). Single-replica services keep their plain name.
            _sid = "{{ peer.service }}" + (f"#{_i + 1}" if len(_urls) > 1 else "")
            meta.append((_sid, _label))
{% endfor %}
    results = await asyncio.gather(*coros, return_exceptions=True)
    parts = []
    for (svc, lbl), r in zip(meta, results):
        if isinstance(r, Exception):
            logging.warning("_fanout: peer %s raised %s", svc, r)
        else:
            parts.append((svc, lbl, r))
    return parts

def _run_fanout(message, only=None):
    # Synchronous wrapper: run the async star fan-out from a BAF state body. Reused for
    # round 1 (collect candidate outputs from producers) and round 2 (collect ballots
    # from voters); `only` selects which peer subset each round addresses.
    _res = []
    _t = threading.Thread(target=lambda: _res.extend(asyncio.run(_fanout(message, only))), daemon=True)
    _t.start(); _t.join(timeout=300)
    return _res
{% endif %}

{% if a2a.role == 'worker' %}
# ── Headless worker: expose an A2A server; handle() runs the LLM (+ optional fan-out) ──
a2a_platform = agent.use_a2a_platform()

async def handle(**params):
    task = params.get("message", "")
    reply = reply_llm.predict(message=task, session=None, system_message=SYSTEM_PROMPT)
{% if a2a.peers %}
    parts = await _fanout(reply)
    peer_ctx = "\n\n".join(f"[{name} · {label}]\n{txt}" for name, label, txt in parts)
    return {"reply": f"{reply}\n\nPeer feedback:\n{peer_ctx}" if peer_ctx else reply}
{% else %}
    return {"reply": reply}
{% endif %}

a2a_platform.router.register("handle", handle)
# BAF runs train() on agent.run(), which needs exactly one initial state even for an
# A2A-only worker whose real entry is handle() above (R5).
idle = agent.new_state('idle', initial=True)
def idle_body(session: Session):
    pass
idle.set_body(idle_body)
{% else %}
# ── Entry (human-facing): websocket UI; work state fans out + synthesizes (plan §3) ──
platform = agent.use_websocket_platform(use_ui=True)

greetings = agent.new_state('greetings', initial=True)
work = agent.new_state('work')

def greetings_body(session: Session):
    session.reply({{ a2a.greeting | tojson }})
greetings.set_body(greetings_body)
greetings.when_no_intent_matched().go_to(work)

def work_body(session: Session):
    task = session.event.message
{% if a2a.peers %}
{% if a2a.governance and a2a.governance.is_voting %}
    # ── item 37: governed candidate-selection vote ────────────────────────────────
    # Phase 2: a human ballot is pending → this message IS the human's chosen candidate.
    _pending = session.get("gov_pending")
    if GOVERNANCE_REQUIRES_HUMAN and _pending:
        session.delete("gov_pending")
        _ids = [c["id"] for c in _pending["candidates"]]
        _hb = {"voter": "human", "source": "human",
               "vote": parse_ballot(task, _ids) or parse_ballot("BALLOT: " + task.strip(), _ids),
               "weight": 1.0, "raw": task}
        _ballots = _pending["ballots"] + [_hb]
        _decision = tally(GOVERNANCE_POLICY_TYPE, GOVERNANCE_RATIO, _pending["candidates"], _ballots)
        logging.info("[governance] %s", json.dumps(_decision))
        # Present the winning candidate VERBATIM — it is already a complete answer from a real
        # producer; the deterministic footer is the single source of truth for the tally.
        _win = _pending["cand_text"].get(_decision["outcome"], "")
        session.reply(_win + _gov_footer(_decision))
        return

    # Round 1 — collect one candidate output from each PRODUCER (the BPMN branches that
    # flow into the gateway). The owner contributes a candidate only if it is itself a
    # producer; a pure judge/merge owner produces none ("the task says so").
    parts = _run_fanout(task, only=set(GOVERNANCE_PRODUCERS))   # [(service_id, label, text)]
    candidates, cand_text = [], {}
    for _i, (_svc, _lbl, _txt) in enumerate(parts, start=1):
        cid = f"C{_i}"; candidates.append({"id": cid, "producer": _svc}); cand_text[cid] = _txt
    if GOVERNANCE_OWNER_PRODUCES:
        own = reply_llm.predict(message=task, session=session,
                                system_message=SYSTEM_PROMPT, parameters=MERGE_PARAMS)
        _own_id = f"C{len(candidates) + 1}"
        candidates.append({"id": _own_id, "producer": GOVERNANCE_SELF or "self"}); cand_text[_own_id] = own
    if not candidates:
        # Every producer branch failed at runtime (peer down / call raised) — there is nothing
        # to vote on. Degrade gracefully instead of tallying an empty slate and presenting "".
        session.reply("No candidate outputs were produced for the governed merge, so there is "
                      "nothing to vote on. Please retry.")
        return
    _ids = [c["id"] for c in candidates]
    cand_block = "\n\n".join(f"[{c['id']}] (from {c['producer']})\n{cand_text[c['id']]}" for c in candidates)

    # Round 2 — each VOTER (the policy participant list) votes over the FULL candidate set;
    # the owner votes in-process only if it is itself a participant.
    _voters = set(GOVERNANCE_WEIGHTS) - {GOVERNANCE_SELF}
    ballots = []
    for _svc, _lbl, _reply in _run_fanout(cand_block + BALLOT_INSTRUCTION, only=_voters):
        ballots.append({"voter": _svc, "source": "agent", "vote": parse_ballot(_reply, _ids),
                        "weight": _gov_weight(_svc), "raw": _reply})
    if GOVERNANCE_OWNER_VOTES:
        _own_vote = _gov_owner_ballot(session, cand_block, _ids)
        ballots.append({"voter": GOVERNANCE_SELF or "self", "source": "owner",
                        "vote": parse_ballot(_own_vote, _ids), "weight": _gov_weight(GOVERNANCE_SELF or ""),
                        "raw": _own_vote})
    for _name in GOVERNANCE_UNRESOLVED:             # participants with no running service
        ballots.append({"voter": _name, "source": "agent", "vote": None, "weight": 1.0, "raw": ""})

    if GOVERNANCE_REQUIRES_HUMAN:
        # Defer the final tally to the human: stash candidates + the agent/owner ballots,
        # present the slate, and let phase 2 (above) add the human ballot and tally.
        session.set("gov_pending", {"candidates": candidates, "cand_text": cand_text, "ballots": ballots})
        session.reply("A governance policy requires human approval before merging.\n\n"
                      + GOVERNANCE_SUMMARY + "\n\nCandidate outputs:\n" + cand_block
                      + "\n\nReply with the ID you choose (e.g. C2).")
        return

    _decision = tally(GOVERNANCE_POLICY_TYPE, GOVERNANCE_RATIO, candidates, ballots)
    logging.info("[governance] %s", json.dumps(_decision))
    # Present the winning candidate VERBATIM — it is already a complete answer from a real
    # producer; re-running it through the LLM only risks mutating it and re-narrating a fake
    # process. The deterministic footer is the single source of truth for the tally.
    _win = cand_text.get(_decision["outcome"]) or next(iter(cand_text.values()), "")
    final = _win + _gov_footer(_decision)
{% else %}
{% if a2a.governance %}
    # Human-in-the-loop phase 2 (item 35, non-voting policies): this message IS the
    # human's decision. Apply it to the stashed candidates WITHOUT re-running the swarm.
    _pending = session.get("gov_pending")
    if GOVERNANCE_REQUIRES_HUMAN and _pending:
        session.delete("gov_pending")
        sys_msg = SYSTEM_PROMPT + "\n\n" + GOVERNANCE_INSTRUCTION
        final = reply_llm.predict(
            message=("Original task: " + _pending["task"]
                     + "\n\nCollaborators' replies:\n" + _pending["ctx"]
                     + "\n\nThe human's decision: " + task
                     + "\n\nProduce the final merged answer that honours the human's decision."),
            session=session, system_message=sys_msg, parameters=MERGE_PARAMS)
        session.reply(final)
        return
{% endif %}
    parts = _run_fanout(task)
    ctx = "\n\n".join(f"[{name} · {label}]\n{txt}" for name, label, txt in parts)
{% if a2a.governance %}
    if GOVERNANCE_REQUIRES_HUMAN:
        session.set("gov_pending", {"task": task, "ctx": ctx})
        session.reply("A governance policy requires human approval before merging.\n\n"
                      + GOVERNANCE_SUMMARY
                      + "\n\nCandidate replies:\n" + ctx
                      + "\n\nReply with your decision (choose one, combine, or edit).")
        return
    sys_msg = SYSTEM_PROMPT + "\n\n" + GOVERNANCE_INSTRUCTION
    final = reply_llm.predict(message=f"Task: {task}\n\nCollaborators' replies:\n{ctx}",
                              session=session, system_message=sys_msg, parameters=MERGE_PARAMS)
{% else %}
    final = reply_llm.predict(message=f"Task: {task}\n\nTeam results:\n{ctx}",
                              session=session, system_message=SYSTEM_PROMPT)
{% endif %}
{% endif %}
{% else %}
    final = reply_llm.predict(message=task, session=session, system_message=SYSTEM_PROMPT)
{% endif %}
    session.reply(final)
work.set_body(work_body)
work.when_no_intent_matched().go_to(work)
{% endif %}

if __name__ == '__main__':
    agent.run()
