def _fm_owner_ballot(cand_block, ids):
    # The owner's own ballot must carry a parseable `BALLOT: C<k>` line; validate + re-prompt
    # once at temperature 0 before recording it as an abstain (mirrors the single-merge path).
    _msg = cand_block + BALLOT_INSTRUCTION
    _txt = ""
    for _attempt in range(2):
        _txt = reply_llm.predict(message=_msg, session=None, system_message=SYSTEM_PROMPT,
                                 parameters=MERGE_PARAMS)
        if parse_ballot(_txt, ids) is not None:
            return _txt
        _msg = (cand_block + BALLOT_INSTRUCTION + "\n\nYour previous reply did NOT end with the "
                "required `BALLOT: C<k>` line. Reply again, ending with exactly that line.")
    logging.warning("[governance] owner ballot missing a valid BALLOT line after retry; abstaining")
    return _txt

async def _run_merge(cfg, task, params):
    # PUSH model — the producer's output (this incoming message) IS the candidate that tripped
    # the guarded transition into this merge state. The owner may also self-produce in-process.
    candidates = [{"id": "C1", "producer": params.get("from") or "producer"}]
    cand_text = {"C1": task}
    if cfg["owner_produces"]:
        _own = reply_llm.predict(message=task, session=None, system_message=SYSTEM_PROMPT,
                                 parameters=MERGE_PARAMS)
        _cid = f"C{len(candidates) + 1}"
        candidates.append({"id": _cid, "producer": cfg["self"]}); cand_text[_cid] = _own
    if not cfg["is_voting"]:
        # Non-voting policy (Leader/Consensus/Lazy): single-round merge of the pushed candidate.
        _sys = SYSTEM_PROMPT + (("\n\n" + cfg["instruction"]) if cfg["instruction"] else "")
        _final = reply_llm.predict(message=f"Candidate to finalize:\n{task}", session=None,
                                   system_message=_sys, parameters=MERGE_PARAMS)
        return {"reply": _final}
    _ids = [c["id"] for c in candidates]
    cand_block = "\n\n".join(f"[{c['id']}] (from {c['producer']})\n{cand_text[c['id']]}"
                             for c in candidates)
    # Round 2 — one ballot from each resolvable voter (policy participants minus the owner).
    ballots = []
    _voters = set(cfg["weights"]) - {cfg["self"]}
    if _voters:
        for _svc, _lbl, _reply in _run_fanout(cand_block + BALLOT_INSTRUCTION, only=_voters):
            ballots.append({"voter": _svc, "source": "agent", "vote": parse_ballot(_reply, _ids),
                            "weight": _fm_weight(_svc, cfg["weights"]), "raw": _reply})
    if cfg["owner_votes"]:
        _ob = _fm_owner_ballot(cand_block, _ids)
        ballots.append({"voter": cfg["self"], "source": "owner", "vote": parse_ballot(_ob, _ids),
                        "weight": _fm_weight(cfg["self"], cfg["weights"]), "raw": _ob})
    for _name in cfg["unresolved"]:                 # participant with no running service
        ballots.append({"voter": _name, "source": "agent", "vote": None, "weight": 1.0, "raw": ""})
    if cfg["requires_human"]:
        # O1 — a headless worker cannot prompt the human locally. Surface the candidate slate +
        # the agent/owner ballots up to the ENTRY (which owns the websocket UI); the entry takes
        # the human ballot and runs the final tally. The merge PAUSES here pending that step.
        return {"reply": "A governance policy requires human approval before merging.\n\n"
                + cfg["summary"] + "\n\nCandidate outputs:\n" + cand_block,
                "gov_pending": {"gateway": params.get("flow"), "policy_type": cfg["policy_type"],
                                "ratio": cfg["ratio"], "candidates": candidates,
                                "cand_text": cand_text, "ballots": ballots}}
    _decision = tally(cfg["policy_type"], cfg["ratio"], candidates, ballots)
    logging.info("[governance] %s", json.dumps(_decision))
    # Present the winner VERBATIM — it is already a complete producer answer; the deterministic
    # footer is the single source of truth for the tally.
    _win = cand_text.get(_decision["outcome"]) or next(iter(cand_text.values()), "")
    return {"reply": _win + _fm_footer(_decision)}
