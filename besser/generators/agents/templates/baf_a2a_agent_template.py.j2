# ── 35b-5 entry un-flatten: faithful sequential governed-merge pipeline ───────────────
# This agent feeds more than one governed merging gateway (often the SAME owner). The
# authored flow visits each merge in turn, so the swarm must too — a single deduped fan-out
# would collapse them. _merge_send delivers one PUSH to a merge owner (tagged with the
# gateway id so the owner runs THAT merge) and returns its merged result; _run_merge_pipeline
# threads the task through the merges in authored order, each stage feeding the next.
_MERGE_PIPELINE = [
{% for send in a2a.merge_sends %}
    ({{ send.service | tojson }}, {{ send.target_gateway | tojson }}),
{% endfor %}
]

def _a2a_call_full(base_url, agent_id, message, flow):
    # Like _a2a_call but returns the WHOLE result envelope, so the initiator can see a
    # `gov_pending` a merge owner attaches when it pauses for human approval (O1).
    body = json.dumps({"jsonrpc": "2.0", "agent_id": agent_id, "method": "handle",
                       "params": {"message": message, "flow": flow}, "id": 1}).encode()
    req = urllib.request.Request(f"{base_url}/a2a", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.loads(r.read()).get("result") or {}

def _merge_send(message, service, flow):
    # One pipeline stage: PUSH to the merge owner; return (merged_text, gov_pending|None).
    _text, _pending = message, None
    for _url in _peer_replica_urls(service):
        try:
            _res = _a2a_call_full(_url, service, message, flow)
        except Exception as _e:                       # peer down / call failed → skip replica
            logging.warning("_merge_send: %s (%s) raised %s", service, flow, _e)
            continue
        if _res.get("reply"):
            _text = _res["reply"]
        if _res.get("gov_pending"):                   # owner paused for human approval (O1)
            _pending = _res["gov_pending"]
    return _text, _pending

def _run_merge_pipeline(task):
    # Headless initiator (no human UI): thread the task through each merge. If an owner pauses
    # for human approval a headless caller can't resolve it — return the approval notice as-is.
    _result = task
    for _service, _flow in _MERGE_PIPELINE:
        _result, _pending = _merge_send(_result, _service, _flow)
        if _pending:
            return _result
    return _result
